{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-switch",
  "identifier": "com.llt22.omp-switch",
  "build": {
    "beforeDevCommand": {
      "script": "bun server.ts",
      "cwd": "..",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:8642",
    "beforeBuildCommand": "",
    "frontendDist": "http://127.0.0.1:8642"
  },
  "app": {
    "windows": [
      {
        "title": "OMP Switch",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/omp-switch-server"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
